default_platform(:ios)

platform :ios do
  desc "App Store Connect にアップロード & 審査提出（ローカル最新化含む）"
  lane :release do
    sh("cd ../.. && git stash; git pull origin main --rebase; git stash pop || true")
    sh("cd ../.. && flutter clean")
    sh("cd ../.. && flutter pub get")
    sh("rm -rf Pods Podfile.lock && pod install --repo-update")
    # flutter build ios + gym の二重ビルドは避け、archive + export を一度に行う
    sh("cd ../.. && flutter build ipa --export-method app-store")

    ipa_dir = File.expand_path("../build/ios/ipa", Dir.pwd)
    ipa_candidates = Dir.glob(File.join(ipa_dir, "*.ipa"))
    UI.user_error!("IPA が見つかりません (#{ipa_dir})。flutter build ipa のログを確認してください。") if ipa_candidates.empty?
    ipa_path = ipa_candidates.max_by { |f| File.mtime(f) }

    upload_to_app_store(
      ipa: ipa_path,
      force: true,
      skip_metadata: false,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: true,
      automatic_release: true,
      release_notes: {
        "ja" => "・「さがす」でエントリー締切後・開催中の大会も一覧に表示されるように改善\n・エントリー締切日を過ぎた大会のステータスを「エントリー締切」にそろえるよう改善（主催者向け）\n・大会作成・編集時にも締切日とステータスを整合\n・細かな安定性向上"
      }
    )
  end

  desc "TestFlight にアップロード（ベータテスト用、ローカル最新化含む）"
  lane :beta do
    sh("cd ../.. && git stash; git pull origin main --rebase; git stash pop || true")
    sh("cd ../.. && flutter clean")
    sh("cd ../.. && flutter pub get")
    sh("rm -rf Pods Podfile.lock && pod install --repo-update")
    sh("cd ../.. && flutter build ipa --export-method app-store")

    ipa_dir = File.expand_path("../build/ios/ipa", Dir.pwd)
    ipa_candidates = Dir.glob(File.join(ipa_dir, "*.ipa"))
    UI.user_error!("IPA が見つかりません (#{ipa_dir})。flutter build ipa のログを確認してください。") if ipa_candidates.empty?
    ipa_path = ipa_candidates.max_by { |f| File.mtime(f) }

    upload_to_testflight(
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )
  end
end
