default_platform(:ios)

platform :ios do
  desc "App Store Connect にアップロード & 審査提出（ローカル最新化含む）"
  lane :release do
    # 未追跡（ios/Podfile.lock 等）があると手動の git pull が失敗するため -u で退避
    sh("cd ../.. && git stash push -u -m 'fastlane-release' || true; git pull origin main --rebase; git stash pop || true")
    sh("cd ../.. && flutter clean")
    sh("cd ../.. && flutter pub get")
    sh("rm -rf Pods Podfile.lock && pod install --repo-update")
    # flutter build ios + gym の二重ビルドは避け、archive + export を一度に行う
    sh("cd ../.. && flutter build ipa --export-method app-store")

    # Dir.pwd は ios/fastlane になることが多く、../build が ios/build に誤解決する。Flutter の出力はリポジトリルートの build/ios/ipa。
    ipa_dir = File.expand_path("../../build/ios/ipa", __dir__)
    ipa_candidates = Dir.glob(File.join(ipa_dir, "*.ipa"))
    UI.user_error!("IPA が見つかりません (#{ipa_dir})。flutter build ipa のログを確認してください。") if ipa_candidates.empty?
    ipa_path = ipa_candidates.max_by { |f| File.mtime(f) }

    upload_to_app_store(
      ipa: ipa_path,
      force: true,
      skip_metadata: false,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: true,
      automatic_release: true,
      release_notes: {
        "ja" => "・公式アカウントの投稿を見やすく刷新。複数の画像を横スワイプで切り替えられるようになりました\n・画像をタップすると全画面表示に。全画面でも横スワイプで前後の画像に移動でき、×ボタン・画像タップ・下スワイプで閉じられます\n・画像がすぐ表示されるように改善（読み込みのもたつきを解消）\n・その他、細かな表示の調整と安定性の改善"
      }
    )
  end

  desc "TestFlight にアップロード（ベータテスト用、ローカル最新化含む）"
  lane :beta do
    # 未追跡（ios/Podfile.lock 等）があると手動の git pull が失敗するため -u で退避
    sh("cd ../.. && git stash push -u -m 'fastlane-release' || true; git pull origin main --rebase; git stash pop || true")
    sh("cd ../.. && flutter clean")
    sh("cd ../.. && flutter pub get")
    sh("rm -rf Pods Podfile.lock && pod install --repo-update")
    sh("cd ../.. && flutter build ipa --export-method app-store")

    # Dir.pwd は ios/fastlane になることが多く、../build が ios/build に誤解決する。Flutter の出力はリポジトリルートの build/ios/ipa。
    ipa_dir = File.expand_path("../../build/ios/ipa", __dir__)
    ipa_candidates = Dir.glob(File.join(ipa_dir, "*.ipa"))
    UI.user_error!("IPA が見つかりません (#{ipa_dir})。flutter build ipa のログを確認してください。") if ipa_candidates.empty?
    ipa_path = ipa_candidates.max_by { |f| File.mtime(f) }

    upload_to_testflight(
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )
  end
end
