default_platform(:ios)

platform :ios do
  desc "App Store Connect にアップロード & 審査提出（ローカル最新化含む）"
  lane :release do
    sh("cd ../.. && git stash; git pull origin main --rebase; git stash pop || true")
    sh("cd ../.. && flutter clean")
    sh("cd ../.. && flutter pub get")
    sh("rm -rf Pods Podfile.lock && pod install --repo-update")
    sh("cd ../.. && flutter build ios --release")

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      output_directory: "../build/ios",
      output_name: "Sofvo.ipa"
    )

    upload_to_app_store(
      force: true,
      skip_metadata: false,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: true,
      automatic_release: true,
      release_notes: {
        "ja" => "・アップデート案内の不具合を修正（新しいバージョンが公開された時に確実にお知らせ）\n・iOS 17以降でアプリアイコンの未読バッジが残ってしまう問題を修正\n・エントリー締切後も一般参加者が対戦表を見られるように修正\n・主催者メニューに「予選1の対戦表を生成」ボタンを追加"
      }
    )
  end

  desc "TestFlight にアップロード（ベータテスト用、ローカル最新化含む）"
  lane :beta do
    sh("cd ../.. && git stash; git pull origin main --rebase; git stash pop || true")
    sh("cd ../.. && flutter clean")
    sh("cd ../.. && flutter pub get")
    sh("rm -rf Pods Podfile.lock && pod install --repo-update")
    sh("cd ../.. && flutter build ios --release")

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      output_directory: "../build/ios",
      output_name: "Sofvo.ipa"
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end
end
