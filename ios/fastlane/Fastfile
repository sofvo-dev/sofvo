default_platform(:ios)

platform :ios do
  desc "App Store Connect にアップロード & 審査提出（ローカル最新化含む）"
  lane :release do
    sh("cd ../.. && git stash; git pull origin main --rebase; git stash pop || true")
    sh("cd ../.. && flutter clean")
    sh("cd ../.. && flutter pub get")
    sh("rm -rf Pods Podfile.lock && pod install --repo-update")
    sh("cd ../.. && flutter build ios --release")

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      output_directory: "../build/ios",
      output_name: "Sofvo.ipa"
    )

    upload_to_app_store(
      force: true,
      skip_metadata: false,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: true,
      automatic_release: true,
      release_notes: {
        "ja" => "・公式アカウント向け：「マイ大会」で主催する大会のみを一覧表示（参加大会は非表示）\n・公式向けの空状態・説明文を控えめに調整\n・その他細かな改善・安定性向上"
      }
    )
  end

  desc "TestFlight にアップロード（ベータテスト用、ローカル最新化含む）"
  lane :beta do
    sh("cd ../.. && git stash; git pull origin main --rebase; git stash pop || true")
    sh("cd ../.. && flutter clean")
    sh("cd ../.. && flutter pub get")
    sh("rm -rf Pods Podfile.lock && pod install --repo-update")
    sh("cd ../.. && flutter build ios --release")

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      output_directory: "../build/ios",
      output_name: "Sofvo.ipa"
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end
end
