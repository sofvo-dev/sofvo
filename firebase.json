{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "sofvo-19d84",
          "appId": "1:584952056517:android:8a450aa9331e839b2afeac",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "sofvo-19d84",
          "appId": "1:584952056517:ios:9ede07a32db745ec2afeac",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "macos": {
        "default": {
          "projectId": "sofvo-19d84",
          "appId": "1:584952056517:ios:9ede07a32db745ec2afeac",
          "uploadDebugSymbols": false,
          "fileOutput": "macos/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "sofvo-19d84",
          "configurations": {
            "android": "1:584952056517:android:8a450aa9331e839b2afeac",
            "ios": "1:584952056517:ios:9ede07a32db745ec2afeac",
            "macos": "1:584952056517:ios:9ede07a32db745ec2afeac",
            "web": "1:584952056517:web:9c58d1dd3ed79cd02afeac",
            "windows": "1:584952056517:web:7217e98dd99267b22afeac"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "build/web",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          { "key": "Content-Type", "value": "application/json" }
        ]
      },
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          { "key": "Content-Type", "value": "application/json" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "flutter_bootstrap.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "flutter_service_worker.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0" }
        ]
      },
      {
        "source": "main.dart.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/auth-action",
        "destination": "/auth-action.html"
      },
      {
        "source": "/invite",
        "destination": "/invite.html"
      },

      { "source": "/pc/tournament/*/score", "destination": "/pc/tournament/_/score/index.html" },
      { "source": "/pc/tournament/*/score/**", "destination": "/pc/tournament/_/score/index.html" },
      { "source": "/pc/tournament/*/notices", "destination": "/pc/tournament/_/notices/index.html" },
      { "source": "/pc/tournament/*/notices/**", "destination": "/pc/tournament/_/notices/index.html" },
      { "source": "/pc/tournament/*/finance", "destination": "/pc/tournament/_/finance/index.html" },
      { "source": "/pc/tournament/*/finance/**", "destination": "/pc/tournament/_/finance/index.html" },
      { "source": "/pc/tournament/*/checkin", "destination": "/pc/tournament/_/checkin/index.html" },
      { "source": "/pc/tournament/*/checkin/**", "destination": "/pc/tournament/_/checkin/index.html" },
      { "source": "/pc/tournament/*/post-event", "destination": "/pc/tournament/_/post-event/index.html" },
      { "source": "/pc/tournament/*/post-event/**", "destination": "/pc/tournament/_/post-event/index.html" },
      { "source": "/pc/tournament/*/manage", "destination": "/pc/tournament/_/manage/index.html" },
      { "source": "/pc/tournament/*/manage/**", "destination": "/pc/tournament/_/manage/index.html" },
      { "source": "/pc/tournament/*", "destination": "/pc/tournament/_/index.html" },

      { "source": "/pc/gadgets/*/edit", "destination": "/pc/gadgets/_/edit/index.html" },
      { "source": "/pc/gadgets/*/edit/**", "destination": "/pc/gadgets/_/edit/index.html" },

      { "source": "/pc/admin/surveys/*", "destination": "/pc/admin/surveys/_/index.html" },

      { "source": "/pc/chat/*", "destination": "/pc/chat/_/index.html" },
      { "source": "/pc/teams/*", "destination": "/pc/teams/_/index.html" },
      { "source": "/pc/profile/*", "destination": "/pc/profile/_/index.html" },

      {
        "source": "/app/**",
        "destination": "/index.html"
      }
    ]
  }
}
