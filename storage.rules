rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 認証済みユーザーのみ読み取り可能
    match /{allPaths=**} {
      allow read: if request.auth != null;
    }

    // アバター: avatars/{uid}.{ext} — 自分のUIDで始まるファイルのみ書き込み可
    match /avatars/{fileName} {
      allow write: if request.auth != null
                   && fileName.matches(request.auth.uid + '\\..+')
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // チャット画像: chat_images/{chatId}/{fileName}
    match /chat_images/{chatId}/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // チャットファイル: chat_files/{chatId}/{fileName}
    match /chat_files/{chatId}/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024;
    }

    // チャットアイコン: chat_icons/{chatId}/{fileName}
    match /chat_icons/{chatId}/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // グループアイコン: group_icons/{fileName}
    match /group_icons/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // チャットアルバム: chat_albums/{chatId}/{fileName}
    match /chat_albums/{chatId}/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024;
    }

    // 大会ルールPDF: tournament_rules/{uid}/{fileName}
    match /tournament_rules/{userId}/{fileName} {
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024;
    }

    // 大会対戦表: tournament_board/{tournamentId}/{fileName}
    match /tournament_board/{tournamentId}/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024;
    }

    // 大会写真: tournament_photos/{tournamentId}/{fileName}
    match /tournament_photos/{tournamentId}/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024;
    }

    // 投稿画像: post_images/{uid}/{fileName}
    match /post_images/{userId}/{fileName} {
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
