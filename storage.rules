rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 認証済みユーザーのみ読み取り可能
    match /{allPaths=**} {
      allow read: if request.auth != null;
    }

    // アバター: 自分のファイルのみアップロード可能（5MB以下、画像のみ）
    match /avatars/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // チャット画像
    match /chat_images/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // チャットファイル
    match /chat_files/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024;
    }

    // チャットアイコン
    match /chat_icons/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // グループアイコン
    match /group_icons/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // チャットアルバム
    match /chat_albums/{allPaths=**} {
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024;
    }

    // 大会ルールPDF
    match /tournament_rules/{userId}/{fileName} {
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024;
    }

    // 大会対戦表
    match /tournament_board/{tournamentId}/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024;
    }

    // 大会写真
    match /tournament_photos/{allPaths=**} {
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
