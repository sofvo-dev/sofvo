rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ━━━━ 共通関数 ━━━━
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isNotBlocked(targetUserId) {
      return !exists(/databases/$(database)/documents/users/$(targetUserId)/blockedUsers/$(request.auth.uid));
    }

    // 大会ドキュメントを ID で参照し、主催者・編集者・管理者かどうか（サブコレクションルール用）
    function canManageTournamentById(tournamentId) {
      let t = get(/databases/$(database)/documents/tournaments/$(tournamentId)).data;
      return request.auth.uid == t.organizerId
        || (t.keys().hasAny(['editors']) && request.auth.uid in t.editors)
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ━━━ ユーザー ━━━
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // 個人情報（メール、性別、生年月日、FCMトークン等）— 本人のみアクセス可
      match /private/{docId} {
        allow read, write: if isOwner(userId);
      }

      // チャットボット履歴 — 本人と管理者のみ
      match /chatbotHistory/{historyId} {
        allow read: if isOwner(userId) || (isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
        allow write: if false;
      }

      // フォロー
      match /following/{followId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }

      // フォロワー
      match /followers/{followerId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && isOwner(followerId);
        allow delete: if isOwner(userId) || isOwner(followerId);
      }

      // 通知
      match /notifications/{notifId} {
        allow read: if isOwner(userId);
        allow create: if isAuthenticated();
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // ブックマーク
      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(userId);
      }

      // ブロックリスト
      match /blockedUsers/{blockedId} {
        allow read, write: if isOwner(userId);
      }

      // ガジェット
      match /gadgets/{gadgetId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }

      // ガジェットカテゴリ
      match /gadgetCategories/{categoryId} {
        allow read, write: if isOwner(userId);
      }

      // ポイント履歴
      match /pointHistory/{historyId} {
        allow read: if isOwner(userId);
        allow write: if isAuthenticated();
      }

      // 非表示投稿
      match /hiddenPosts/{postId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ━━━ 投稿 ━━━
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      match /likes/{likeId} {
        allow read: if isAuthenticated();
        allow create, delete: if isAuthenticated() && isOwner(likeId);
      }

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      }
    }

    // ━━━ 大会 ━━━
    match /tournaments/{tournamentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.organizerId == request.auth.uid
        || (resource.data.keys().hasAny(['editors']) && request.auth.uid in resource.data.editors)
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );

      // エントリー
      match /entries/{entryId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }

      // 収支管理（経費）— 主催者・編集者・管理者のみ
      match /expenses/{expenseId} {
        allow read, create, update, delete: if isAuthenticated() && canManageTournamentById(tournamentId);
      }

      // ラウンド
      match /rounds/{roundId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();

        match /{document=**} {
          allow read: if isAuthenticated();
          allow write: if isAuthenticated();
        }
      }

      // ブラケット（決勝トーナメント）
      match /brackets/{bracketId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();

        match /{document=**} {
          allow read: if isAuthenticated();
          allow write: if isAuthenticated();
        }
      }

      // 大会タイムライン（掲示板）
      match /timeline/{postId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated();

        match /likes/{likeId} {
          allow read: if isAuthenticated();
          allow create, delete: if isAuthenticated() && isOwner(likeId);
        }
      }

      // チーム掲示板
      match /team_board/{teamId} {
        allow read: if isAuthenticated();

        match /posts/{postId} {
          allow read: if isAuthenticated();
          allow create: if isAuthenticated();
        }
      }

      // 大会フォトギャラリー
      match /photos/{photoId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow delete: if isAuthenticated() && resource.data.uploadedBy == request.auth.uid;
      }
    }

    // ━━━ チーム ━━━
    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && request.auth.uid in resource.data.memberIds;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // ━━━ チャット ━━━
    match /chats/{chatId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.members;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && request.auth.uid in resource.data.members;

      match /messages/{messageId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow update: if isAuthenticated() && resource.data.senderId == request.auth.uid;
      }

      match /album/{albumId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow delete: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
      }

      match /notes/{noteId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow update, delete: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
      }
    }

    // ━━━ 会場 ━━━
    match /venues/{venueId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }

    // ━━━ 通報 ━━━
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      allow update: if isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ━━━ お知らせ ━━━
    match /notices/{noticeId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ━━━ メンバー募集 ━━━
    match /recruitments/{recruitId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ━━━ 景品 ━━━
    match /prizes/{prizeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.registeredBy == request.auth.uid;

      match /reviews/{reviewId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      }
    }

    // ━━━ アプリ設定 ━━━
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ━━━ 景品カテゴリ ━━━
    match /prizeCategories/{categoryId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ━━━ スポンサー ━━━
    match /sponsors/{sponsorId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ━━━ アンケート ━━━
    match /surveys/{surveyId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;

      match /responses/{responseId} {
        allow read: if isAuthenticated()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
        allow create: if isAuthenticated() && isOwner(responseId);
      }
    }

    // ━━━ シーズン ━━━
    match /seasons/{seasonId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ━━━ ブログ記事 ━━━
    match /articles/{articleId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ━━━ 大会テンプレート ━━━
    match /tournamentTemplates/{templateId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ━━━ チャットボットログ（全体分析用、管理者のみ閲覧可） ━━━
    match /chatbotLogs/{logId} {
      allow read: if isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      allow write: if false;
    }
  }
}
